root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = off

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{ts,js}]
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{c,cpp,cxx}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
indent_size = 8
trim_trailing_whitespace = false

[*.yaml]
indent_size = 4

[*.toml]
indent_size = 4
